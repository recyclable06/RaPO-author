          "text": "                    os.path.basename(config.trainer.load_checkpoint_path).split(\"global_step_\")[-1]"
        },
        {
          "line": 1413,
          "text": "                )"
        },
        {
          "line": 1414,
          "text": "            except Exception:"
        },
        {
          "line": 1415,
          "text": "                pass"
        },
        {
          "line": 1416,
          "text": ""
        },
        {
          "line": 1417,
          "text": "        # ���� EMA state ������������������������������������������������������������������������������������������������������"
        },
        {
          "line": 1418,
          "text": "        ema_state_path = _ema_stats_file_from_task_dir(config.trainer.save_checkpoint_path)"
        },
        {
          "line": 1419,
          "text": "        ema_initial_state = ("
        },
        {
          "line": 1420,
          "text": "            _read_json(boundary[\"_ema_path\"])"
        },
        {
          "line": 1421,
          "text": "            if fresh_boundary_resume and boundary is not None"
        },
        {
          "line": 1422,
          "text": "            else _load_ema_state(ema_state_path)"
        },
        {
          "line": 1423,
          "text": "        )"
        },
        {
          "line": 1424,
          "text": ""
        },
        {
          "line": 1425,
          "text": "        # ���� Reinitialise trainer for this task ����������������������������������������������������"
        },
        {
          "line": 1426,
          "text": "        if fresh_boundary_resume:"
        },
        {
          "line": 1427,
          "text": "            checkpoint_path = boundary[\"_checkpoint_path\"]"
        },
        {
          "line": 1428,
          "text": "            trainer.reinit_for_task("
        },
        {
          "line": 1429,
          "text": "                train_dataloader=train_dataloader,"
        },
        {
          "line": 1430,
          "text": "                val_dataloader=val_dataloader,"
        },
        {
          "line": 1431,
          "text": "                task_id=task_id,"
        },
        {
          "line": 1432,
          "text": "                per_task_steps=per_task_steps,"
        },
        {
          "line": 1433,
          "text": "                last_global_step=last_global_step,"
        },
        {
          "line": 1434,
          "text": "                save_checkpoint_path=config.trainer.save_checkpoint_path,"
        },
        {
          "line": 1435,
          "text": "                load_checkpoint_path=checkpoint_path,"
        },
        {
          "line": 1436,
          "text": "                ema_adv_state=ema_initial_state,"
        },
        {
          "line": 1437,
          "text": "                enable_anchor=enable_anchor,"
        },
        {
          "line": 1438,
          "text": "                fresh_boundary_resume=True,"
        },
        {
          "line": 1439,
          "text": "            )"
        },
        {
          "line": 1440,
          "text": "            trainer.restore_boundary_checkpoint(checkpoint_path, int(boundary[\"global_step\"]))"
        },
        {
          "line": 1441,
          "text": "            vllm_payloads = []"
        },
        {
          "line": 1442,
          "text": "            for item in boundary[\"rng\"][\"vllm\"]:"
        },
        {
          "line": 1443,
          "text": "                payload = _read_json(_safe_join(boundary[\"_boundary_root\"], item[\"relative_path\"]))"
        },
        {
          "line": 1444,
          "text": "                vllm_payloads.append(payload)"
        },
        {
          "line": 1445,
          "text": "            payload_by_rank = {int(item[\"rank\"]): item for item in vllm_payloads}"
        },
        {
          "line": 1446,
          "text": "            trainer.actor_rollout_ref_wg.restore_boundary_vllm_rng("
        },
        {
          "line": 1447,
          "text": "                [payload_by_rank[rank] for rank in sorted(payload_by_rank)]"
        },
        {
          "line": 1448,
          "text": "            )"
        }
      ],
