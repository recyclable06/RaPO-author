          "line": 1385,
          "text": "            # native actor state before any Task-2 rollout or anchor copy."
        },
        {
          "line": 1386,
          "text": "            _restore_driver_rng_state(_read_json(boundary[\"_driver_path\"]))"
        },
        {
          "line": 1387,
          "text": ""
        },
        {
          "line": 1388,
          "text": "        # ���� Build task-specific dataloaders ����������������������������������������������������������"
        },
        {
          "line": 1389,
          "text": "        train_dataloader = base._build_dataloader("
        },
        {
          "line": 1390,
          "text": "            config.data, tokenizer, processor, allowed_classes,"
        },
        {
          "line": 1391,
          "text": "            is_train=True, label_list_override=prompt_label_list,"
        },
        {
          "line": 1392,
          "text": "            allowed_class_order=allowed_class_order,"
        },
        {
          "line": 1393,
          "text": "        )"
        },
        {
          "line": 1394,
          "text": "        val_dataloader = base._build_dataloader("
        },
        {
          "line": 1395,
          "text": "            config.data, tokenizer, processor, allowed_classes,"
        },
        {
          "line": 1396,
          "text": "            is_train=False, label_list_override=prompt_label_list,"
        },
        {
          "line": 1397,
          "text": "            allowed_class_order=allowed_class_order,"
        },
        {
          "line": 1398,
          "text": "        )"
        },
        {
          "line": 1399,
          "text": ""
        },
        {
          "line": 1400,
          "text": "        # ���� Compute per-task steps ����������������������������������������������������������������������������"
        },
        {
          "line": 1401,
          "text": "        per_task_steps = config.trainer.max_steps"
        },
        {
          "line": 1402,
          "text": "        if config.trainer.total_epochs is not None:"
        },
        {
          "line": 1403,
          "text": "            try:"
        },
        {
          "line": 1404,
          "text": "                per_task_steps = config.trainer.total_epochs * len(train_dataloader)"
        },
        {
          "line": 1405,
          "text": "            except Exception:"
        },
        {
          "line": 1406,
          "text": "                pass"
        },
        {
          "line": 1407,
          "text": ""
        },
        {
          "line": 1408,
          "text": "        last_global_step = 0"
        },
        {
          "line": 1409,
          "text": "        if config.trainer.load_checkpoint_path:"
        },
        {
          "line": 1410,
          "text": "            try:"
