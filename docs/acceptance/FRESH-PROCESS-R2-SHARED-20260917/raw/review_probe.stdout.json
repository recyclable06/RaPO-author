          "text": "        self.anchor_fsdp_module = self.ref_fsdp_module"
        },
        {
          "line": 1007,
          "text": "        self.ref_fsdp_module = existing_ref"
        },
        {
          "line": 1008,
          "text": ""
        },
        {
          "line": 1009,
          "text": "        from verl.workers.actor.dp_actor import DataParallelPPOActor"
        },
        {
          "line": 1010,
          "text": ""
        },
        {
          "line": 1011,
          "text": "        self.anchor_policy = DataParallelPPOActor("
        },
        {
          "line": 1012,
          "text": "            config=self.config.ref,"
        },
        {
          "line": 1013,
          "text": "            actor_module=self.anchor_fsdp_module,"
        },
        {
          "line": 1014,
          "text": "        )"
        }
      ],
      "main_order": [
        {
          "line": 1789,
          "text": "    # Initialise the frozen anchor model on all workers. A failure here is fatal:"
        },
        {
          "line": 1790,
          "text": "    # the retention reward requires anchor log-probs from task 2 onward."
        },
        {
          "line": 1791,
          "text": "    ray.get(runner.init_anchor_on_workers.remote())"
        },
        {
          "line": 1792,
          "text": "    if resume_boundary is not None:"
        },
        {
          "line": 1793,
          "text": "        # This happens after worker construction but before the first fresh"
        },
        {
          "line": 1794,
          "text": "        # Task-2 dataloader is built. Native/vLLM streams are restored after"
        },
        {
          "line": 1795,
          "text": "        # the native actor checkpoint load inside run_task()."
        },
        {
          "line": 1796,
          "text": "        ray.get(runner.restore_boundary_driver_rng.remote(resume_boundary[\"_driver_path\"]))"
        }
      ],
      "run_task_checkpoint_restore": [
        {
          "line": 1379,
          "text": "        if fresh_boundary_resume:"
        },
        {
          "line": 1380,
          "text": "            if boundary is None:"
        },
        {
          "line": 1381,
          "text": "                raise CILBoundaryError(\"fresh boundary resume needs validated boundary metadata\")"
        },
        {
          "line": 1382,
          "text": "            if not copy_actor_to_anchor or not enable_anchor:"
        },
        {
          "line": 1383,
          "text": "                raise CILBoundaryError(\"fresh boundary resume requires the Task-2 previous-task anchor\")"
        },
        {
          "line": 1384,
          "text": "            # The runner is a new process. Restore driver/vLLM streams and"
