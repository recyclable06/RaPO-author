      "summary": "No SIGTERM/SIGINT handler or finally path guarantees cleanup when the supervisor is interrupted."
    },
    "FINDING-A-SUPERVISOR-LAUNCHER-DESCENDANT-007": {
      "status": "OPEN",
      "summary": "Supervisor-level timeout kills only the launcher session; R2 production child uses a separate session and is not discovered by supervisor cleanup."
    },
    "FINDING-A-SUPERVISOR-HEAD-PIPE-008": {
      "status": "OPEN",
      "summary": "Ray head stdout/stderr pipes are not drained during readiness and final logs are not guaranteed complete."
    },
    "FINDING-A-ZEROGPU-MANIFEST-GUARD-009": {
      "status": "OPEN",
      "summary": "Zero-GPU wrapper loads the supplied parent file without validating the zero-GPU or frozen parent manifest/hash before head startup."
    },
